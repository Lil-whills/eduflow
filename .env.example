# Environment Configuration Example
# Copy this file to backend/.env and configure your secrets

# Django Core
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-50-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=eduflow_db
DB_USER=whatsUpUcc_admin
DB_PASSWORD=admin1234
DB_HOST=localhost
DB_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

