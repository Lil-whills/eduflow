# Django Backend Environment Configuration Example
SECRET_KEY=replace-with-a-secure-random-secret-key-dev
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_ENGINE=django.db.backends.postgresql
DB_NAME=eduflow_db
DB_USER=whatsUpUcc_admin
DB_PASSWORD=admin1234
DB_HOST=localhost
DB_PORT=5432

# Encryption Key for AES-256-GCM (32 random bytes base64-encoded)
EDUFLOW_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Cache / Redis
REDIS_URL=redis://127.0.0.1:6379/1

# CORS & CSRF Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
